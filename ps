Import-Module ActiveDirectory

$server = (Get-ADDomain -Identity 'VCN').DNSRoot
$principal = Get-ADGroup -Identity 'cs-ws-joiner' -Server $server
$target = Get-ADGroup -Identity 'Domain Admins' -Server $server -Properties nTSecurityDescriptor

$target.nTSecurityDescriptor.Access |
    Where-Object {
        try {
            $_.IdentityReference.Translate(
                [System.Security.Principal.SecurityIdentifier]
            ).Value -eq $principal.SID.Value
        } catch {
            $false
        }
    } |
    Select-Object IdentityReference, AccessControlType, ActiveDirectoryRights,
                  ObjectType, IsInherited
