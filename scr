<p>Hello <span style="font-family: 'Segoe UI', sans-serif; font-weight: bold;"> good sir, please respond to this message normally.</span></p>
</body>
</html>
"@
 
$mailMessage = New-Object System.Net.Mail.MailMessage
$mailMessage.From = New-Object System.Net.Mail.MailAddress("savvas.kechagias@volvo.com")
